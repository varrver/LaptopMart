<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_laptop"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/winter_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_laptop_image"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:contentDescription="@string/laptop"
            android:scaleType="fitCenter"
            tools:src="@tools:sample/backgrounds/scenic" />

        <TextView
            android:id="@+id/tv_laptop_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/navy_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Acer Nitro 5" />

        <TextView
            android:id="@+id/tv_laptop_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/navy_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Rp 15.000.000" />

        <TextView
            android:id="@+id/tv_laptop_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/navy_blue"
            android:textSize="12sp"
            tools:text="10" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>